{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "yarnloop": {
          ".validate": "newData.hasChildren(['unlocked', 'current'])",
          "unlocked": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 400" },
          "current": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 400" },
          "updatedAt": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      }
    },
    "leaderboard": {
      ".read": true,
      ".indexOn": ["score"],
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['name', 'cleared', 'reachedAt', 'score'])",
        "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 12" },
        "cleared": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 400" },
        "reachedAt": { ".validate": "newData.isNumber() && newData.val() <= now + 60000" },
        "score": { ".validate": "newData.isNumber()" },
        "updatedAt": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    }
  }
}
